<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
  id="http://iptvpremiumplayer.com/widget" version="1.0.0">

  <name>IPTV Premium Player</name>
  <description>Premium IPTV Player for Samsung Smart TV. Stream live TV, movies, and series from your IPTV subscription.</description>
  <author>IPTV Premium Player</author>

  <icon src="icon.png" />
  <content src="index.html" />

  <tizen:application id="AbCdEf1234.IPTVPlayer" package="AbCdEf1234" required_version="2.3" />

  <tizen:metadata key="http://samsung.com/tv/metadata/multitasking" value="enable" />
  <tizen:metadata key="http://samsung.com/tv/metadata/devel" value="true" />

  <!-- Allow internet/video access -->
  <access origin="*" subdomains="true" />
  <tizen:privilege name="http://tizen.org/privilege/internet" />
  <tizen:privilege name="http://tizen.org/privilege/network.get" />
  <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice" />
  <tizen:privilege name="http://developer.samsung.com/privilege/productinfo" />

  <tizen:setting background-support="enable" encryption="disable" context-menu="disable" hwkey-event="enable" />

  <feature name="http://tizen.org/feature/screen.size" value="1920x1080" />
</widget>
